# Copy to .env.local (never commit real keys).

# Frontend (Vite). Leave empty to use the developer sign-in (local demos only).
VITE_CLERK_PUBLISHABLE_KEY=

# Service (Python). See docs/command-system-contract.md §1 and docs/mac-showcase.md.
CLERK_SECRET_KEY=
CLERK_ISSUER=
NIVRA_AUTHORIZED_PARTIES=http://127.0.0.1:8765,http://localhost:8765
NIVRA_ADMIN_EMAILS=
NIVRA_AUTH_MODE=
NIVRA_ALLOWED_ORIGINS=
